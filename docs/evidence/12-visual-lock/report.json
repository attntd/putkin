    "config": "# Hyprlock 0.9.6. Appearance only; authentication stays in Hyprlock.\n# The Putkin launcher supplies the saved accents, motion preference and wallpaper.\n$putkinAccent = rgb(cba6f7)\n$putkinSecondary = rgb(89b4fa)\n$putkinMotion = true\n$putkinWallpaper = /home/attntd/.config/hypr/backgrounds/Cloudsnight.jpg\n$putkinFont = JetBrainsMono Nerd Font Mono\n\ngeneral {\n    hide_cursor = true\n}\nanimations {\n    enabled = $putkinMotion\n    bezier = linear, 0, 0, 1, 1\n    animation = fadeIn, 1, 1.2, linear\n    animation = fadeOut, 1, 1.2, linear\n    animation = inputField, 0\n}\nbackground {\n    monitor =\n    path = $putkinWallpaper\n    color = rgb(1e1e2e)\n    blur_passes = 0\n}\n# A flat overlay dims the actual wallpaper without blurring or scaling it.\nshape {\n    monitor =\n    size = 100%, 100%\n    color = rgba(18182588)\n    rounding = 0\n    border_size = 0\n    position = 0, 0\n    halign = center\n    valign = center\n    zindex = 1\n}\nlabel {\n    monitor =\n    text = 22:57\n    color = $putkinAccent\n    font_size = 64\n    font_family = $putkinFont\n    position = 0, 110\n    halign = center\n    valign = center\n    zindex = 2\n}\nlabel {\n    monitor =\n    text = środa 16 września\n    color = rgb(cdd6f4)\n    font_size = 16\n    font_family = $putkinFont\n    position = 0, 46\n    halign = center\n    valign = center\n    zindex = 2\n}\ninput-field {\n    monitor =\n    size = 360, 44\n    outline_thickness = 2\n    rounding = 0\n    outer_color = $putkinAccent\n    inner_color = rgb(181825)\n    font_color = rgb(cdd6f4)\n    check_color = $putkinSecondary\n    fail_color = rgb(f38ba8)\n    font_family = $putkinFont\n    placeholder_text = Hasło…\n    fail_text =\n    check_text =\n    fade_on_empty = false\n    dots_size = 0.25\n    dots_spacing = 0.3\n    position = 0, -30\n    halign = center\n    valign = center\n    zindex = 2\n}\n\nauth {\n    pam:enabled = true\n    pam:module = putkin-preview\n    fingerprint:enabled = f