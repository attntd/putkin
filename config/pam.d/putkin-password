# Preserve the login checks and the system password policy with rate limits.
# Use an absolute include: pam_start_confdir resolves relative includes here.
# system-local-login also contains fprintd on this host; scanning has its own
# conversation so it cannot delay the password prompt.
auth required pam_shells.so
auth requisite pam_nologin.so
auth include /etc/pam.d/system-auth
