#!/usr/bin/env python3
"""Real Qt URL drops and dialog selectedFiles; private XDG/D-Bus and offscreen."""
import subprocess
import tempfile
from pathlib import Path
from _common import ROOT, isolated_environment, tool

with tempfile.TemporaryDirectory(prefix="pk-media-input-") as tmp:
    env = isolated_environment(tmp)
    executable = Path(tmp) / "input-test"
    flags = subprocess.check_output(["pkg-config", "--cflags", "--libs", "Qt6Quick", "Qt6Test"], text=True).split()
    subprocess.run(["c++", "-std=c++20", "-fPIC", "-pie", str(ROOT / "tests/signal_media_input.cpp"), "-o", str(executable), *flags], check=True)
    result = subprocess.run([tool("dbus-run-session"), "--", str(executable), str(ROOT / "tests/media-input.qml"),
        str(ROOT / "tests/fixtures/signal/media/image.png"), str(ROOT / "tests/fixtures/signal/media/document.txt")], env=env, timeout=30)
    raise SystemExit(result.returncode)
