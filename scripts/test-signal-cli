#!/usr/bin/env python3
"""Probe an explicitly supplied signal-cli in a fresh, networkless sandbox.

No accounts, home directory, session buses or host runtime are mounted.
This is an S00 API probe, not a phone/integration acceptance test.
"""

import argparse
import hashlib
import json
from pathlib import Path
import shutil
import subprocess
import sys

from _common import ROOT
from _signal_install import runtime


VERSION = "0.14.8"


def sandbox(executable, java_home=None):
    bwrap = shutil.which("bwrap")
    if not bwrap:
        raise RuntimeError("bwrap is required; there is no unisolated fallback")
    command = [bwrap, "--unshare-all", "--die-with-parent", "--new-session",
               "--ro-bind", "/usr", "/usr", "--symlink", "usr/bin", "/bin",
               "--symlink", "usr/lib", "/lib",
               "--symlink", "usr/lib", "/lib64", "--proc", "/proc", "--dev", "/dev",
               "--tmpfs", "/tmp",
               "--clearenv", "--setenv", "PATH", "/usr/bin", "--setenv", "LANG", "C.UTF-8"]
    if java_home:
        command += ["--ro-bind", str(executable.parent.parent), "/tool/distribution",
                    "--ro-bind", str(java_home), "/tool/jre", "--setenv", "JAVA_HOME", "/tool/jre"]
        entry = "/tool/distribution/bin/" + executable.name
    else:
        command += ["--ro-bind", str(executable), "/tool/signal-cli"]
        entry = "/tool/signal-cli"
    for kind in ("CONFIG", "DATA", "STATE", "CACHE", "RUNTIME"):
        variable = f"XDG_{kind}_{'DIR' if kind == 'RUNTIME' else 'HOME'}"
        command += ["--setenv", variable, f"/tmp/{kind.lower()}"]
    return command + ["--", entry, "--data-dir", "/tmp/account"]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--executable", type=Path, help="Osobna sonda upstream; domyślnie przypięty runtime Putkina")
    parser.add_argument("--runtime", type=Path, help="Opcjonalny gotowy runtime; domyślnie automatyczny wybór/budowanie")
    parser.add_argument("--cache", type=Path)
    parser.add_argument("--offline", action="store_true")
    parser.add_argument("--java-home", type=Path, help="Explicit extracted JRE for the JVM distribution")
    parser.add_argument("--output", type=Path, default=ROOT / "artifacts/signal-cli.json")
    args = parser.parse_args()
    if args.executable and args.runtime:
        parser.error("--runtime i --executable są rozłączne")
    if args.java_home and not args.executable:
        parser.error("--java-home wymaga --executable; runtime sam zawiera Javę")
    policy = None
    if not args.executable:
        from _install import current, paths
        bundle, policy = runtime(ROOT, args.runtime, prepare=True, cache=args.cache,
                                 offline=args.offline, installed=current(paths()["store"]))
        args.executable = bundle / "cli/bin/signal-cli"
        args.java_home = bundle / "jre"
    executable = args.executable.resolve(strict=True)
    report = {"scope": "offline, empty account; no linking or messaging",
              "version": VERSION, "binarySha256": hashlib.sha256(executable.read_bytes()).hexdigest(),
              "runtime": policy, "checks": [], "passed": False}
    try:
        java_home = args.java_home.resolve(strict=True) if args.java_home else None
        command = sandbox(executable, java_home)
        if java_home:
            report["javaRelease"] = (java_home / "release").read_text()

        def run(name, arguments, payload=None):
            result = subprocess.run(command + arguments, input=payload, text=True,
                                    capture_output=True, timeout=30)
            report["checks"].append({"name": name, "arguments": arguments,
                                     "exitCode": result.returncode, "stdout": result.stdout,
                                     "stderr": result.stderr})
            if result.returncode:
                raise RuntimeError(f"{name}: exit {result.returncode}: {result.stderr.strip()}")
            return result.stdout

        if run("version", ["--version"]).strip() != f"signal-cli {VERSION}":
            raise RuntimeError("Unexpected signal-cli version")
        # Help parses CLI options without opening an account or making a request.
        for method in ("jsonRpc", "link", "send", "sendReceipt", "sendReaction",
                       "remoteDelete", "sendTyping", "getAttachment", "listContacts",
                       "listGroups", "updateGroup", "updateContact", "joinGroup", "quitGroup"):
            run(f"help:{method}", [method, "--help"])

        requests = [
            {"jsonrpc": "2.0", "id": "accounts", "method": "listAccounts"},
            {"jsonrpc": "2.0", "id": "subscribe", "method": "subscribeReceive"},
            {"jsonrpc": "2.0", "id": "unknown", "method": "putkinUnknownMethod"},
            {"jsonrpc": "2.0", "id": "no-account", "method": "listGroups"},
            {"jsonrpc": "2.0", "id": "invalid-link", "method": "finishLink", "params": {}},
        ]
        # Account validation distinguishes exposed RPC commands from unknown methods.
        # It does not prove their behavior with a linked account.
        account_methods = ("send", "sendReceipt", "sendReaction", "remoteDelete", "sendTyping",
                           "getAttachment", "listContacts", "updateGroup", "updateContact",
                           "joinGroup", "quitGroup", "sendSyncRequest", "getUserStatus")
        requests += [{"jsonrpc": "2.0", "id": method, "method": method} for method in account_methods]
        output = run("jsonrpc-empty-store", ["jsonRpc", "--receive-mode", "manual"],
                     "\n".join(json.dumps(request) for request in requests) + "\n")
        replies = [json.loads(line) for line in output.splitlines()]
        by_id = {reply["id"]: reply for reply in replies}
        assert len(replies) == len(requests) == len(by_id), "Missing/duplicate JSON-RPC reply"
        assert all(reply["jsonrpc"] == "2.0" for reply in replies)
        assert by_id["accounts"]["result"] == []
        assert type(by_id["subscribe"]["result"]) is int
        assert by_id["unknown"]["error"]["code"] == -32601
        assert by_id["no-account"]["error"]["code"] == -32602
        assert by_id["invalid-link"]["error"]["code"] == -1
        for method in account_methods:
            assert by_id[method]["error"]["code"] == -32602, method
        report["passed"] = True
    except (OSError, ValueError, KeyError, AssertionError, RuntimeError, subprocess.SubprocessError) as error:
        report["failure"] = str(error)
    finally:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(json.dumps(report, indent=2, ensure_ascii=False) + "\n")
    print(f"{'PASS' if report['passed'] else 'FAIL'}: signal-cli offline probe; {args.output}")
    return 0 if report["passed"] else 1


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        sys.exit("test-signal-cli: " + str(error))
