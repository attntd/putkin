#!/usr/bin/env python3
"""S10 groups QML windows/SQLite/bridge with synthetic CLI and private XDG/D-Bus."""
import argparse
from contextlib import closing
import ctypes
import json
from pathlib import Path
import sqlite3
import subprocess
import sys
import tempfile
import time
import traceback

from _common import ROOT, ipc_json, ipc_reply, isolated_environment, qml_errors, runtime_log, stop_process_group, tool
sys.path.insert(0, str(ROOT / "tests"))
from test_signal_history import event, send_result
from test_signal_interactions import edit, reaction, typing
from test_signal_retention import disappearing, deletion
from test_signal_lifecycle import gone
from test_signal_groups import group, OWN, PEER, GROUP, CREATED


def eventually(read, predicate, seconds=15):
    deadline = time.monotonic() + seconds
    value = None
    while time.monotonic() < deadline:
        value = read()
        if predicate(value):
            return value
        time.sleep(.04)
    raise AssertionError("Receipt condition timed out: " + str(value))


def run(output):
    output.parent.mkdir(parents=True, exist_ok=True)
    report = {"passed": False, "scope": "production QML windows/SQLite/bridge; synthetic CLI; offscreen/private XDG/D-Bus; no phone/compositor", "checks": []}
    ctypes.CDLL(None).prctl(36, 1, 0, 0, 0)
    with tempfile.TemporaryDirectory(prefix="pk-s10-") as tmp:
        base = Path(tmp)
        env = isolated_environment(tmp)
        env["QS_NO_RELOAD_POPUP"] = "1"
        address = "unix:path=" + str(base / "bus")
        env["DBUS_SESSION_BUS_ADDRESS"] = address
        fixture, record = base / "fixture.json", base / "processes.jsonl"
        stamp = int(time.time() * 1000) - 10000
        directory = base / "directory.json"
        fixture.write_text(json.dumps({"format": 1, "synthetic": True, "record": str(record), "receiveEvents": [], "readReceipts": False, "groups": [group()], "directoryFile": str(directory),
            "interactionTimestamp": stamp + 5000, "sendResult": send_result(stamp + 6000),
            "contacts": [{"number": "+12025550100", "uuid": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa", "messageExpirationTime": 0},
                         {"number": "+12025550101", "uuid": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb", "name": "Alicja", "messageExpirationTime": 0}]}))
        config = Path(env["XDG_CONFIG_HOME"]) / "putkin"
        config.mkdir(mode=0o700)
        (config / "signal.json").write_text(json.dumps({"v": 1, "enabled": True, "deviceName": "Putkin", "typingIndicators": True}))
        (config / "signal.json").chmod(0o600)
        env["PUTKIN_SIGNAL_TEST_SCENARIO"] = str(fixture)
        entrypoint = str(ROOT / "signal-groups-test.qml")
        processes, logs, helpers = [], [], set()
        def start(cmd, name):
            log = (base / (name + ".log")).open("w+")
            logs.append((name, log))
            process = subprocess.Popen(cmd, env=env, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
            processes.append(process)
            return process
        def ipc(method, *args):
            result = subprocess.run([tool("quickshell"), "ipc", "--path", entrypoint, "call", "probe", method, *[str(v).lower() if isinstance(v, bool) else str(v) for v in args]],
                env=env, capture_output=True, text=True, timeout=5)
            return ipc_reply(result, shell, logs, starting=method == "snapshot")
        def snapshot():
            value = ipc_json(ipc("snapshot"))
            if value.get("pid"): helpers.add(value["pid"])
            return value
        def records(kind):
            return [v for v in map(json.loads, record.read_text().splitlines()) if v["kind"] == kind] if record.exists() else []
        def query(sql):
            with closing(sqlite3.connect(Path(env["XDG_DATA_HOME"]) / "putkin/signal/history.sqlite3")) as db:
                return db.execute(sql).fetchall()
        def receive(wire):
            ipc("receive", json.dumps(wire))
        def assert_no_receipts(count):
            time.sleep(.6)
            assert len(records("receipt")) == count, records("receipt")
        try:
            start([tool("dbus-daemon"), "--session", "--nofork", "--address=" + address], "bus")
            eventually(lambda: (base / "bus").exists(), bool)
            shell = start([tool("quickshell"), "--no-color", "--path", entrypoint], "shell")
            ready = eventually(snapshot, lambda v: v.get("state") == "ready")
            assert ipc("createGroup", "Zespół Putkina", "aci:" + PEER) == "true"
            value = eventually(snapshot, lambda v: (v.get("selectedConversation") or {}).get("target") == CREATED and v.get("draftReady") and not v.get("pending"))
            cid = value["selected"]["conversationId"]
            assert len(records("updateGroup")) == 1
            assert "groupId" not in records("updateGroup")[0]["params"]
            ipc("details")
            eventually(snapshot, lambda v: (v.get("groupDetails") or {}).get("canAdmin") and not v.get("pending"))
            assert ipc("capture", str(output.with_name("group-details.png"))) == "true"
            eventually(snapshot, lambda v: v.get("captured"))
            report["checks"].append("native window opens the confirmed created group and renders actual roles, permissions and profile avatar")
            ipc("group", "details", json.dumps({"name": "Projekt po zmianie", "description": "Syntetyczna grupa S10"}))
            value = eventually(snapshot, lambda v: (v.get("selectedConversation") or {}).get("title") == "Projekt po zmianie" and not v.get("pending"))
            assert value["selected"]["conversationId"] == cid
            assert any(row["system"] for row in value["rows"])
            ipc("close")
            receive(event(timestamp=stamp + 1000, group=CREATED, body="Wiadomość do grupy S10"))
            eventually(snapshot, lambda v: len(v.get("history", [])) == 1 and v.get("replyAllowed") and not v.get("pending"))
            eventually(lambda: ipc("reply", "Odpowiedź do grupy"), lambda value: value == "true")
            eventually(lambda: records("send"), lambda rows: len(rows) == 1)
            assert records("send")[0]["params"] == {"groupId": [CREATED]}
            report["checks"].append("closed-window group quick reply targets groupId, never the last author's ACI")
            assert ipc("select", 0) == "true"
            eventually(snapshot, lambda v: v.get("draftReady") and not v.get("pending"))
            ipc("mute", True)
            eventually(snapshot, lambda v: (v.get("selectedConversation") or {}).get("muted") and not v.get("pending"))
            state = json.loads(directory.read_text())
            saved = next(g for g in state["groups"] if g["id"] == CREATED)
            saved["isMember"] = False
            saved["members"] = [m for m in saved["members"] if m.get("uuid") != OWN]
            directory.write_text(json.dumps(state))
            receive({"jsonrpc": "2.0", "method": "receive", "params": {"result": {"account": "+12025550100", "envelope": {"sourceUuid": OWN, "timestamp": stamp + 2000, "syncMessage": {"type": "GROUPS_SYNC"}}}}})
            value = eventually(snapshot, lambda v: (v.get("selectedConversation") or {}).get("requestState") == "left" and not v.get("replyAllowed") and not v.get("pending"))
            assert not value["canSend"]
            assert ipc("reply", "Nie wolno") == "false"
            assert ipc("send") == "false"
            assert len(records("send")) == 1
            report["checks"].append("phone membership refresh disables open composer and old notification reply; local mute preserves received history")
            ipc("details")
            eventually(snapshot, lambda v: (v.get("groupDetails") or {}).get("membership") == "left" and not v.get("pending"))
            assert ipc("capture", str(output.with_name("group-left.png"))) == "true"
            eventually(snapshot, lambda v: v.get("captured"))
            ipc("quit"); shell.wait(timeout=8)
            report["passed"] = True
        except (OSError, AssertionError, subprocess.SubprocessError) as error:
            report["failure"] = traceback.format_exc()
        finally:
            for process in reversed(processes): stop_process_group(process)
            remaining = [pid for pid in helpers | {v["pid"] for v in records("start")} if not gone(pid)]
            combined = runtime_log(logs)
            output.with_suffix(".log").write_text(combined)
            report["qmlErrors"] = qml_errors(combined, allow_offscreen_masks=True)
            report["remainingOwnedProcesses"] = remaining
            if remaining or report["qmlErrors"]: report["passed"] = False
            for _, log in logs: log.close()
    output.write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n")
    print(json.dumps(report, ensure_ascii=False, indent=2))
    return int(not report["passed"])


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, default=ROOT / "artifacts/signal-s10/groups-native.json")
    raise SystemExit(run(parser.parse_args().output.resolve()))
