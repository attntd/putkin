#!/usr/bin/env python3
"""Read-only QML syntax/import gate. 0=pass, 1=QML errors, 2=tool/input failure."""

import argparse
from pathlib import Path
import subprocess
import sys

from _common import ROOT, tool


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("paths", nargs="*", type=Path, help="Pliki/katalogi QML; domyślnie cały projekt")
    args = parser.parse_args()
    try:
        formatter, linter = tool("qmlformat"), tool("qmllint")
    except FileNotFoundError as error:
        print(f"ERROR: {error}", file=sys.stderr)
        return 2

    files = set()
    for path in args.paths or [ROOT]:
        path = path.resolve()
        if not path.exists() or (path.is_file() and path.suffix != ".qml"):
            print(f"ERROR: Nieprawidłowe wejście: {path}", file=sys.stderr)
            return 2
        if path.is_file():
            files.add(path)
        else:
            for candidate in path.rglob("*.qml"):
                if not set(candidate.relative_to(path).parts).intersection({".git", "artifacts", "build", "dist", ".local"}):
                    files.add(candidate)
    if not files:
        print("ERROR: Brak plików QML do sprawdzenia.", file=sys.stderr)
        return 2

    failed = 0
    infrastructure_error = False
    for path in sorted(files):
        bad = False
        for name, command in [
            ("syntax", [formatter, "--ignore-settings", str(path)]),
            ("imports/types", [linter, "--ignore-settings", "--max-warnings", "0", "-I", str(ROOT), str(path)]),
        ]:
            try:
                result = subprocess.run(command, capture_output=True, text=True, timeout=30)
            except (OSError, subprocess.TimeoutExpired) as error:
                print(f"ERROR [{name}] {path}: {error}", file=sys.stderr)
                infrastructure_error = bad = True
                continue
            if result.returncode:
                bad = True
                print(f"FAIL [{name}, exit={result.returncode}] {path}", file=sys.stderr)
                print(result.stderr or result.stdout, file=sys.stderr, end="")
        failed += int(bad)
    print(f"{'FAIL' if failed else 'PASS'}: {len(files)} plików QML, {failed} z błędami.")
    return 2 if infrastructure_error else 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
