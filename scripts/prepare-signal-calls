#!/usr/bin/env python3
"""Prepare the pinned voice-call tunnel, without using Signal or desktop audio."""
import argparse
import json
from pathlib import Path
import shutil
import subprocess
import sys
from _common import ROOT
from _signal_calls import build
from signal_call_runtime import verify

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--source", type=Path, default=ROOT)
parser.add_argument("--cache", type=Path)
parser.add_argument("--output", type=Path, default=ROOT / "artifacts/signal-call-runtime")
parser.add_argument("--offline", action="store_true")
args = parser.parse_args()
try:
    bundle = build(args.source.resolve(), args.cache, args.offline)
    if args.output.exists():
        verify(args.output, args.source)
    else:
        shutil.copytree(bundle, args.output)
    print(json.dumps({"bundle": str(args.output), "binary": str(verify(args.output, args.source))}))
except (OSError, ValueError, subprocess.SubprocessError) as error:
    sys.exit("prepare-signal-calls: " + str(error))
