#!/usr/bin/env python3
"""Request the lock in the running Putkin; never launch another shell."""
from pathlib import Path
import subprocess
import sys

# Keep the stable config directory: Quickshell's IPC identity uses the launch
# path, even when that directory is a symlink to an immutable build.
root = Path(__file__).absolute().parents[1]
result = subprocess.run(["quickshell", "ipc", "--path", str(root / "shell.qml"), "call", "session", "lock"],
                        capture_output=True, text=True, timeout=5)
reply = result.stdout.strip()
if result.returncode or reply not in ("accepted", "busy"):
    print(result.stderr.strip() or reply or "Putkin nie przyjął blokady.", file=sys.stderr)
    sys.exit(1)
print(reply)
