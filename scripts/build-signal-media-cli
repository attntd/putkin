#!/usr/bin/env python3
"""Build the S09 pinned retention/media policy into a private copy. No downloads/activation."""
import argparse
import hashlib
import json
from pathlib import Path
import shutil
import subprocess
import tempfile
import zipfile

ROOT = Path(__file__).resolve().parents[1]
POLICY = ROOT / "services/signal-cli-media"


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ("source", "distribution", "jdk", "output"):
        parser.add_argument("--" + name, type=Path, required=True)
    args = parser.parse_args()
    recipe = json.loads((POLICY / "recipe.json").read_text())
    library = args.distribution / "lib/libsignal-cli-0.14.8.jar"
    if sha(library) != recipe["originalLibrary"]:
        raise ValueError("Wrong original CLI library")
    application = args.distribution / "lib/signal-cli-0.14.8.jar"
    if sha(application) != recipe["originalApplication"]:
        raise ValueError("Wrong original CLI application")
    if args.output.exists():
        raise ValueError("Output must be a new private directory")
    with tempfile.TemporaryDirectory(prefix="pk-media-build-") as tmp:
        work = Path(tmp)
        for name, digest in recipe["sources"].items():
            source = args.source / name
            if sha(source) != digest:
                raise ValueError("Wrong upstream source: " + name)
            shutil.copyfile(source, work / name)
            subprocess.run(["patch", "--batch", "--fuzz=0", str(work / name), str(POLICY / (name + ".patch"))], check=True)
        classes = work / "classes"
        subprocess.run([str(args.jdk / "bin/javac"), "-proc:none", "-cp", str(args.distribution / "lib/*"), "-d", str(classes),
                        *map(str, work.glob("*.java")), *map(str, POLICY.glob("*.java"))], check=True)
        subprocess.run([str(args.jdk / "bin/java"), "-cp", str(classes), "org.asamk.signal.manager.helper.PutkinMediaPolicy"], check=True)
        # Existing entries keep their timestamps; added entries use a constant.
        replacement = {str(f.relative_to(classes)): f.read_bytes() for f in classes.rglob("*.class")}
        shutil.copytree(args.distribution, args.output)
        manifest = {"policy": recipe["policy"]}
        for original_path, label in ((library, "librarySha256"), (application, "applicationSha256")):
            patched = args.output / "lib" / original_path.name
            subset = {name: data for name, data in replacement.items()
                      if (name.startswith(("org/asamk/signal/json/", "org/asamk/signal/util/"))) == (original_path == application)}
            with zipfile.ZipFile(original_path) as original, zipfile.ZipFile(patched, "w", zipfile.ZIP_DEFLATED) as output:
                for info in original.infolist():
                    output.writestr(info, subset.pop(info.filename, original.read(info.filename)))
                for name, data in sorted(subset.items()):
                    output.writestr(zipfile.ZipInfo(name, (2000, 1, 1, 0, 0, 0)), data)
            manifest[label] = sha(patched)
        (args.output / "putkin-media-policy.json").write_text(json.dumps(manifest, indent=2) + "\n")
        print(json.dumps(manifest))


if __name__ == "__main__":
    main()
