#!/usr/bin/env python3
"""Real panel IPC, LazyLoader lifecycle and memory samples; mock-only offscreen."""

import argparse
from datetime import datetime, timezone
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import subprocess
import sys
import tempfile
import time

from _common import ROOT, ipc_reply, ipc_json, isolated_environment, qml_errors, stop_process_group, tool

# Reuse the established /proc measurement, not a second process matcher.
loader = importlib.machinery.SourceFileLoader("putkin_measure_idle", str(ROOT / "scripts/measure-idle"))
spec = importlib.util.spec_from_loader(loader.name, loader)
measurement = importlib.util.module_from_spec(spec)
loader.exec_module(measurement)


def eventually(read, predicate, description):
    deadline = time.monotonic() + 6
    last = None
    while time.monotonic() < deadline:
        last = read()
        if predicate(last):
            return last
        time.sleep(0.02)
    raise AssertionError(f"{description}: {last}")


def run(output):
    quickshell, dbus = tool("quickshell"), tool("dbus-run-session")
    entrypoint = str(ROOT / "panels-test.qml")
    output.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="pk-") as directory:
        env = isolated_environment(directory)
        env.update(PUTKIN_SCENARIO="closed", PUTKIN_PREVIEW_WIDTH="1000", PUTKIN_PREVIEW_HEIGHT="700")
        with tempfile.TemporaryFile(mode="w+") as log:
            process = subprocess.Popen([dbus, "--", quickshell, "--no-color", "--path", entrypoint],
                                       env=env, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)

            def ipc(target, method, *args, starting=False):
                result = subprocess.run([quickshell, "ipc", "--path", entrypoint, "call", target, method, *map(str, args)],
                                        env=env, capture_output=True, text=True, timeout=4)
                return ipc_reply(result, process, log, starting=starting)

            def state():
                value = ipc("probe", "snapshot", starting=True)
                return ipc_json(value)

            try:
                eventually(state, lambda s: "loaded" in s, "entrypoint ready")
                time.sleep(0.15)  # Startup timer completes before exercising IPC.
                assert ipc("probe", "openUnknown") == "unknown-surface"
                assert state()["activeId"] == ""
                assert ipc("ui", "openQuickSettings") == "ok"
                # This fixture includes Caffeinate, now the first available
                # tile before the footer's Settings button.
                eventually(state, lambda s: s.get("loaded") and s.get("focus") == "caffeinateToggle", "IPC focus")
                count = state()["created"]
                ipc("probe", "reopenImmediately")
                time.sleep(0.2)
                assert state()["created"] == count and state()["interactive"], "old fade must not destroy a reopened view"
                assert ipc("ui", "openSettings") == "ok"
                eventually(state, lambda s: s.get("focus") == "backButton", "settings replaces page")
                assert state()["created"] == count + 1, "settings creates a separate window"
                ipc("probe", "selectMonitor", "TEST-2")
                assert ipc("ui", "openQuickSettings") == "ok"
                eventually(state, lambda s: s.get("screen") == "TEST-2" and s.get("loaded"), "focused monitor")
                assert state()["created"] - state()["destroyed"] == 1
                ipc("probe", "removeSecond")
                eventually(state, lambda s: s.get("loaded") is False, "hotplug releases loader")
                assert ipc("ui", "openQuickSettings") == "ok"
                eventually(state, lambda s: s.get("loaded") and s.get("screen") == "TEST-1", "monitor fallback")
                ipc("ui", "closePanels")
                closed = eventually(state, lambda s: s.get("loaded") is False, "close")
                assert closed["created"] == closed["destroyed"]

                initial_tree = measurement.process_tree(process.pid)
                shells = [p for p in initial_tree if p["parent"] == process.pid
                          and b"--path" in Path(f"/proc/{p['pid']}/cmdline").read_bytes().split(b"\0")]
                assert len(shells) == 1, initial_tree
                pid = shells[0]["pid"]
                samples = [{"cycle": 0, **measurement.snapshot(pid)}]
                for cycle in range(1, 21):
                    assert ipc("ui", "toggleQuickSettings") == "ok"
                    opened = eventually(state, lambda s: s.get("loaded") and s.get("focus") == "caffeinateToggle", "cycle open")
                    assert opened["created"] - opened["destroyed"] == 1
                    assert ipc("ui", "toggleQuickSettings") == "ok"
                    closing = state()
                    assert not closing["interactive"] and not closing["pageEnabled"]
                    closed = eventually(state, lambda s: s.get("loaded") is False, "cycle close")
                    assert closed["created"] == closed["destroyed"], closed
                    samples.append({"cycle": cycle, **measurement.snapshot(pid)})
                ipc("probe", "clearScreens")
                assert ipc("ui", "openSettings") == "screen-unavailable"
                assert state()["activeId"] == ""
                final_tree = measurement.process_tree(process.pid)
                assert not [p for p in final_tree if p["parent"] == pid], "no shell child processes"
                report = {
                    "timestamp_utc": datetime.now(timezone.utc).isoformat(),
                    "mode": "offscreen/software; real Quickshell LazyLoader + IPC, mock monitors and Item surface",
                    "cycles": 20, "live_surfaces_after_close": closed["created"] - closed["destroyed"],
                    "rss_kib": {"start": samples[0]["rss_kib"], "end": samples[-1]["rss_kib"],
                                "min": min(s["rss_kib"] for s in samples), "max": max(s["rss_kib"] for s in samples)},
                    "initial_process_tree": initial_tree, "final_process_tree": final_tree, "samples": samples,
                }
                log.seek(0)
                logs = log.read()
                assert not qml_errors(logs, allow_offscreen_masks=True), logs
                output.write_text(json.dumps(report, indent=2, ensure_ascii=False) + "\n")
                print(f"PASS: real panel IPC + LazyLoader, 20 cycles, 0 live surfaces; RSS {report['rss_kib']}")
            finally:
                stop_process_group(process)
                log.seek(0)
                output.with_suffix(".log").write_text(log.read())


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, default=ROOT / "artifacts/panels-cycles.json")
    args = parser.parse_args()
    try:
        run(args.output.resolve())
    except (AssertionError, OSError, subprocess.SubprocessError) as error:
        print(f"FAIL: {error}; log: {args.output.with_suffix('.log')}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
