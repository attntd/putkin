#!/usr/bin/env python3
"""S11 integrated scenario and measured 10,000-message history in private XDG/D-Bus."""
import argparse
import ctypes
import json
from pathlib import Path
import subprocess
import sys
import tempfile
import traceback
from _common import ROOT, isolated_environment, qml_errors, runtime_log, stop_process_group, tool
sys.path.insert(0, str(ROOT/'tests'))
from signal_acceptance import Driver, eventually, prepare
from test_signal_lifecycle import gone


def run(output, count=10000, scenario_only=False):
    output.mkdir(parents=True, exist_ok=True)
    report = {'passed': False, 'scope': 'synthetic CLI + real QML/SQLite/pipes, private D-Bus/XDG, offscreen; no phone'}
    ctypes.CDLL(None).prctl(36, 1, 0, 0, 0)
    with tempfile.TemporaryDirectory(prefix='pk-s11-') as tmp:
        base = Path(tmp); env = isolated_environment(tmp)
        env['QS_NO_RELOAD_POPUP'] = '1'
        env['DBUS_SESSION_BUS_ADDRESS'] = 'unix:path='+str(base/'bus')
        processes, logs, driver = [], [], None
        def launch(command, name):
            log = (base/(name+'.log')).open('w+'); logs.append((name, log))
            app = subprocess.Popen(command, env=env, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
            processes.append(app); return app, log
        try:
            seeded = prepare(env, base, count)
            report['history'] = {k: v for k,v in seeded.items() if k not in ('record', 'cid', 'stamp')}
            launch([tool('dbus-daemon'), '--session', '--nofork', '--address='+env['DBUS_SESSION_BUS_ADDRESS']], 'bus')
            eventually(lambda: (base/'bus').exists(), bool, 'private bus')
            app, log = launch([tool('quickshell'), '--no-color', '--path', str(ROOT/'signal-acceptance-test.qml')], 'shell')
            driver = Driver(env, base, app, log, seeded)
            def capture(name):
                assert driver.ipc('capture', str(output/(name+'.png'))) == 'true'
                driver.wait(lambda s: s.get('captured'), 'rendered capture')
            driver.e2e(capture)
            if not scenario_only: report['performance'] = driver.performance()
            report['scenarioOnly'] = scenario_only
            report['checks'] = driver.checks
            driver.ipc('quit'); app.wait(timeout=8)
            report['passed'] = True
        except Exception:
            report['failure'] = traceback.format_exc()
        finally:
            for app in reversed(processes): stop_process_group(app)
            raw = runtime_log(logs)
            (output/'runtime.log').write_text(raw)
            report['qmlErrors'] = qml_errors(raw, allow_offscreen_masks=True)
            if driver:
                report['remainingOwnedProcesses'] = [pid for pid in driver.helpers | {r['pid'] for r in driver.records('start')} if not gone(pid)]
            if report['qmlErrors'] or report.get('remainingOwnedProcesses'): report['passed'] = False
            assert 'S11_EXPIRING_PRIVATE_MARKER' not in raw and 'sgnl://linkdevice?' not in raw
            for _, log in logs: log.close()
    (output/'report.json').write_text(json.dumps(report, indent=2, ensure_ascii=False)+'\n')
    print(json.dumps({k:v for k,v in report.items() if k != 'performance'}, indent=2, ensure_ascii=False))
    return int(not report['passed'])


if __name__ == '__main__':
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output', type=Path, default=ROOT/'artifacts/signal-s11/acceptance')
    parser.add_argument('--messages', type=int, default=10000)
    parser.add_argument('--scenario-only', action='store_true')
    args = parser.parse_args()
    raise SystemExit(run(args.output.resolve(), args.messages, args.scenario_only))
