#!/usr/bin/env python3
"""Fetch Google's selected Material Symbols, or rebuild their local QML paths.

Normal builds use the checked-in files and need no network. --fetch is an
explicit maintainer operation; the manifest records each downloaded checksum.
"""
import argparse
import concurrent.futures
import hashlib
import json
from pathlib import Path
import urllib.request
import xml.etree.ElementTree as ET

ROOT = Path(__file__).resolve().parents[1]
DEST = ROOT / "assets/material"
NAMES = """add send apps chat chat_bubble search close check check_box check_box_outline_blank indeterminate_check_box
radio_button_checked radio_button_unchecked chevron_right expand_more more_horiz
network_wifi network_wifi_1_bar network_wifi_2_bar network_wifi_3_bar
signal_wifi_0_bar signal_wifi_off settings_ethernet bluetooth bluetooth_disabled
volume_up volume_off mic mic_off brightness_6 device_thermostat
notifications notifications_unread notifications_off delete tune settings lock power_settings_new
logout restart_alt bedtime coffee eco balance bolt terminal folder description
content_paste desktop_windows language movie music_note graphic_eq videocam
code developer_board monitoring print palette font_download translate help
devices share sync link fingerprint refresh open_in_new
battery_android_0 battery_android_1 battery_android_2 battery_android_3
battery_android_4 battery_android_5 battery_android_6 battery_android_full
battery_android_question battery_charging_20_2 battery_charging_30_2
battery_charging_50_2 battery_charging_60_2 battery_charging_80_2 battery_charging_full_2
""".split()
BASE = "https://fonts.gstatic.com/s/i/short-term/release/materialsymbolsoutlined"


def fetch(name):
    url = f"{BASE}/{name}/default/24px.svg"
    data = urllib.request.urlopen(url, timeout=30).read()
    ET.fromstring(data)
    (DEST / f"{name}.svg").write_bytes(data)
    return name, {"url": url, "sha256": hashlib.sha256(data).hexdigest()}


def compile_paths():
    paths = {}
    for file in sorted(DEST.glob("*.svg")):
        svg = ET.fromstring(file.read_text())
        box = [float(value) for value in svg.attrib["viewBox"].split()]
        if box[2] != box[3]:
            raise ValueError(f"Non-square canvas: {file}")
        elements = list(svg)
        if not elements or any(element.tag.rsplit("}", 1)[-1] != "path"
                               or "transform" in element.attrib for element in elements):
            raise ValueError(f"Expected untransformed paths: {file}")
        paths[file.stem] = {"box": box, "path": " ".join(element.attrib["d"] for element in elements)}
        if file.stem.startswith("battery_charging_") and file.stem.endswith("_2"):
            # Android's battery is 480/960 units high; Charging … 2 is 400/960.
            # Trim empty vertical margins to match the body height (400/800),
            # retaining the complete width for Google's external bolt.
            # The downloaded SVG path and its proportions stay unchanged.
            paths[file.stem]["viewport"] = [0, -880, 960, 800]
    missing = set(NAMES) - paths.keys()
    if missing:
        raise ValueError(f"Missing symbols: {sorted(missing)}")
    (DEST / "Paths.js").write_text("// Generated by scripts/update-icons; see LICENSE and manifest.json.\n"
                                   ".pragma library\n\nvar icons = " + json.dumps(paths, ensure_ascii=False, indent=2) + ";\n")
    print(f"Compiled {len(paths)} local vector icons.")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--fetch", action="store_true")
    args = parser.parse_args()
    DEST.mkdir(parents=True, exist_ok=True)
    if args.fetch:
        with concurrent.futures.ThreadPoolExecutor(max_workers=6) as workers:
            manifest = dict(workers.map(fetch, sorted(set(NAMES))))
        license_url = "https://raw.githubusercontent.com/google/material-design-icons/master/LICENSE"
        (DEST / "LICENSE").write_bytes(urllib.request.urlopen(license_url, timeout=30).read())
        (DEST / "manifest.json").write_text(json.dumps({"family": "Material Symbols Outlined",
            "style": {"fill": 0, "weight": 400, "grade": 0, "optical_size": 24},
            "icons": manifest}, indent=2) + "\n")
    compile_paths()


if __name__ == "__main__":
    main()
