#!/usr/bin/env python3
"""Real Qt touchpad events against Message Hub, with private XDG and D-Bus."""
import argparse
import subprocess
import tempfile
from pathlib import Path
from _common import ROOT, isolated_environment, tool, qml_errors

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--output', type=Path, default=ROOT / 'artifacts/messages-input')
args = parser.parse_args()
output = args.output.resolve()
output.mkdir(parents=True, exist_ok=True)
with tempfile.TemporaryDirectory(prefix='pk-messages-input-') as tmp:
    env = isolated_environment(tmp)
    executable = Path(tmp) / 'input-test'
    flags = subprocess.check_output(['pkg-config', '--cflags', '--libs', 'Qt6Quick', 'Qt6Test'], text=True).split()
    subprocess.run(['c++', '-std=c++20', '-fPIC', '-pie', str(ROOT / 'tests/messages_scroll_input.cpp'),
        '-o', str(executable), *flags], check=True)
    result = subprocess.run([tool('dbus-run-session'), '--', str(executable), str(ROOT / 'tests/messages-input.qml'),
        str(output / 'messages.png')], env=env, timeout=60, capture_output=True, text=True)
    log = result.stdout + result.stderr
    (output / 'input.log').write_text(log)
    print(log, end='')
    raise SystemExit(result.returncode or bool(qml_errors(log)))
